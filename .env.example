# ==============================================================================
# Studxy (SWMS) — Production Environment Configuration Example
# Copy to .env (Docker/Local) or configure directly in MonsterASP & Vercel UI
# ==============================================================================

# --- Database (Supabase PostgreSQL / Docker PostgreSQL 17) ---
SWMS_USE_POSTGRES=true
# Dùng ConnectionStrings__Postgres (MonsterASP / .NET env) hoặc DATABASE_URL (URI postgresql://...)
ConnectionStrings__Postgres=Host=aws-1-ap-northeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Timeout=20;Command Timeout=120;KeepAlive=30
SWMS_FORCE_STARTUP_SEED=false

# Dùng cho docker-compose.prod.yml
POSTGRES_USER=swms_user
POSTGRES_PASSWORD=change-this-strong-postgres-password
POSTGRES_DB=swms_db

# --- Security (JWT & AES-256-GCM) ---
JWT_ISSUER=https://api.studxy.vn
JWT_AUDIENCE=https://app.studxy.vn
# Chuỗi ngẫu nhiên tối thiểu 64 ký tự (Backend đọc JWT_SIGNING_KEY hoặc Jwt__SigningKey)
JWT_SIGNING_KEY=replace-with-random-secret-key-at-least-64-characters-long-2026
# Khóa 32-byte mã hóa Base64 (vd: openssl rand -base64 32)
# Lưu ý: Trên MonsterASP đặt tên biến là Security__AesMasterKeyBase64 hoặc SECURITY_AES_MASTER_KEY_BASE64
AES_MASTER_KEY_BASE64=replace-with-32-byte-base64-aes-256-key
Security__AesMasterKeyBase64=replace-with-32-byte-base64-aes-256-key

# --- Google OAuth 2.0 (tùy chọn) ---
Authentication__Google__ClientId=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Networking & CORS ---
# Điền URL Frontend Vercel thực tế (phân tách bằng dấu phẩy, không có dấu / ở cuối)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://studxy.vn
# Trên Vercel đặt BACKEND_INTERNAL_URL = URL HTTPS backend MonsterASP (vd: https://your-api.runasp.net)
BACKEND_INTERNAL_URL=http://127.0.0.1:5080
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- AI Proxy / LLM (tùy chọn — bỏ trống sẽ tự dùng chế độ fallback học thuật nội bộ) ---
AI_PROXY_BASE_URL=
AI_PROXY_API_KEY=
AI_PROXY_MODEL=gemini-3.8-flash
